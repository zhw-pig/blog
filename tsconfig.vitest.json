// 配置 Vitest 测试框架的 TypeScript 编译器选项
// Vitest 是一个用于 JavaScript 和 TypeScript 的极速测试框架。
{
  "extends": "./tsconfig.app.json",
  "exclude": [],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "lib": [],
    "types": ["node", "jsdom"]
  }
}
